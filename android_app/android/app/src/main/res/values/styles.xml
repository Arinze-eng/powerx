<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LIGHT theme (default). The window background is the web app's paper
         canvas, and the system bars carry dark icons — so a cold start looks
         like the web UI's light theme instead of a dark flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/powerx_splash</item>
        <item name="android:navigationBarColor">@color/powerx_splash</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/powerx_splash</item>
        <item name="android:statusBarColor">@color/powerx_splash</item>
        <item name="android:navigationBarColor">@color/powerx_splash</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
