<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window / splash colour for LIGHT mode. This is the WebUI's light
         canvas token (background: 40 20% 99% = #FDFDFC), so the cold start
         is the same paper the web app paints, with no white or dark flash. -->
    <color name="powerx_splash">#FDFDFC</color>
    <!-- Adaptive launcher icon background: the same paper canvas, with the
         orange CDNAI mark centred on top (artwork generated by
         tool/generate_brand_assets.sh from webui/public/brand). -->
    <color name="ic_launcher_background">#FDFDFC</color>
</resources>
