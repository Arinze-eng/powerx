<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode launch theme: solid brand background, dark system bars. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/powerx_splash</item>
        <item name="android:navigationBarColor">@color/powerx_splash</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/powerx_splash</item>
        <item name="android:statusBarColor">@color/powerx_splash</item>
        <item name="android:navigationBarColor">@color/powerx_splash</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
